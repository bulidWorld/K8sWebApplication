[Unit]
Description=KubeScope Kubernetes operations console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run with the existing cluster access of this OS user.
User=zhiwenxia
Environment=HOME=/home/zhiwenxia
WorkingDirectory=/opt/kubescope
EnvironmentFile=/opt/kubescope/.env
ExecStart=/usr/bin/node /opt/kubescope/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
