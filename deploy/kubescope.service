[Unit]
Description=KubeScope Kubernetes operations console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The web process provisions the local host as well as remote nodes.
User=root
Group=root
Environment=HOME=/root
WorkingDirectory=/opt/kubescope
EnvironmentFile=/opt/kubescope/.env
ExecStart=/usr/bin/node /opt/kubescope/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StateDirectory=kubescope
StateDirectory=kubescope-expansion
ReadWritePaths=/opt/kubescope/var
# Local registry configuration writes /run and /etc; cluster installation
# also installs packages into /usr and updates /var. A read-only system
# namespace prevents these explicitly supported host operations.
ProtectSystem=false
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
