[Unit]
Description=KubeScope Kubernetes operations console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The web process runs node expansion directly on the master.
User=root
Group=root
Environment=HOME=/root
WorkingDirectory=/opt/kubescope
EnvironmentFile=/opt/kubescope/.env
ExecStart=/usr/bin/node /opt/kubescope/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StateDirectory=kubescope
StateDirectory=kubescope-expansion
ReadWritePaths=/opt/kubescope/var
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
